# PostgreSQL
POSTGRES_USER=request_admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=request_pdhc
# +psycopg2 is EXPLICIT and load-bearing (#711, #930). This file is what
# the operator copies to make the real .env on a fresh deploy (Rule 23),
# so a bare `postgresql://` here reaches production by hand even when the
# compose is correct. SQLAlchemy 2.1 resolves a bare scheme to psycopg v3,
# which no PDHC service installs.
DATABASE_URL=postgresql+psycopg2://request_admin:CHANGE_ME@localhost:9061/request_pdhc

# Flask
FLASK_SECRET_KEY=CHANGE_ME
FLASK_ENV=development
FLASK_PORT=9060

# Auth
AUTH_DISABLED=true
JWT_SECRET_KEY=CHANGE_ME

# Upstream services
# #1023: ips.pdhc is now eps.pdhc. EPS_* is read first; IPS_BASE_URL /
# IPS_API_KEY are the DEPRECATED fallback, still honoured until #1015 phase 4.
# EPS_API_KEY takes the same value as the IPS_API_KEY it replaces.
EPS_BASE_URL=https://eps.pdhc.se
EPS_API_KEY=
# IPS_BASE_URL=   (deprecated fallback)
# IPS_API_KEY=    (deprecated fallback)
PLAN_BASE_URL=https://plan.pdhc.se
# #931: read_only service key plan.pdhc issues to request.pdhc (must equal plan's REQUEST_PDHC_SERVICE_KEY).
PLAN_SOURCE_SERVICE=request.pdhc
PLAN_SERVICE_KEY=
# #984: icd11.pdhc (clinician diagnosis-review session). Work link base, and the
# key icd11.pdhc sends as X-Service-Key with X-Source-Service: icd11.pdhc.
# Must equal the key configured in icd11.pdhc for calling request.pdhc.
# Empty = icd11.pdhc is refused (401). Never reuse INTERNAL_SERVICE_KEY.
ICD11_BASE_URL=https://icd11.pdhc.se
ICD11_PDHC_SERVICE_KEY=
SSO_BASE_URL=https://sso.pdhc.se
SSO_CALLBACK_URL=http://localhost:9060/api/v1/auth/callback

# Bootstrap superuser (Rule 23) — remove password after first login
BOOTSTRAP_SU_USERNAME=admin
BOOTSTRAP_SU_PASSWORD=CHANGE_ME
