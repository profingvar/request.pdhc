# PostgreSQL
POSTGRES_USER=request_admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=request_pdhc
DATABASE_URL=postgresql://request_admin:CHANGE_ME@localhost:9061/request_pdhc

# Flask
FLASK_SECRET_KEY=CHANGE_ME
FLASK_ENV=development
FLASK_PORT=9060

# Auth
AUTH_DISABLED=true
JWT_SECRET_KEY=CHANGE_ME

# Upstream services
IPS_BASE_URL=https://ips.pdhc.se
PLAN_BASE_URL=https://plan.pdhc.se
SSO_BASE_URL=https://sso.pdhc.se
SSO_CALLBACK_URL=http://localhost:9060/api/v1/auth/callback

# Bootstrap superuser (Rule 23) — remove password after first login
BOOTSTRAP_SU_USERNAME=admin
BOOTSTRAP_SU_PASSWORD=CHANGE_ME
